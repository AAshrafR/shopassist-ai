# ShopAssist AI Configuration
PORT=8000
HOST=0.0.0.0

# LLM Provider: 'grounded_extractive' (default, local, zero API keys required) or 'openai'
LLM_PROVIDER=grounded_extractive

# Optional OpenAI API Key (only required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval Configuration
EMBEDDING_PROVIDER=local_dense
TOP_K=4
HYBRID_ALPHA=0.75
